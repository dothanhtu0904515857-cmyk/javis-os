@@ -0,0 +1,454 @@
+"""Offline voices (Piper): Vietnamese, English and Chinese read aloud with no internet (2026-11-16).
+
+The engine and the three voice files live in `<state>/tts` (`lib/` = the piper-tts package, `voices/` = the .onnx
+models and their .json), outside the app image, so an update does not remove them and a reminder can be spoken at
+any hour even when the free online voice refuses the server. Missing files just mean `speak` returns b"" and the
+caller falls back to the online voice.
+
+Setup (once per machine, also done by `python server/voice_offline.py install`):
+    pip install --target <state>/tts/lib piper-tts
+    voices from https://huggingface.co/rhasspy/piper-voices (vi_VN-vais1000, en_US-lessac, zh_CN-huayan, all "medium")
+"""
+from __future__ import annotations
+
+import asyncio
+import io
+import os
+import re
+import subprocess
+import sys
+import wave
+from pathlib import Path
+from typing import Dict, Optional
+
+VOICES = {
+    "vi": "vi_VN-vais1000-medium",
+    "en": "en_US-lessac-medium",
+    "zh": "zh_CN-huayan-medium",
+}
+_BASE = "https://huggingface.co/rhasspy/piper-voices/resolve/main/"
+_PATHS = {
+    "vi": "vi/vi_VN/vais1000/medium/",
+    "en": "en/en_US/lessac/medium/",
+    "zh": "zh/zh_CN/huayan/medium/",
+}
+_CJK = re.compile(r"[㐀-鿿]")
+_VI = re.compile(r"[ăâđêôơưạảấầẩẫậắằẳẵặẹẻẽếềểễệỉịọỏốồổỗộớờởỡợụủứừửữựỳỵỷỹáàãéèíìĩóòõúùũý]", re.I)
+_LOADED: Dict[str, object] = {}
+
+# One manner of speaking for every voice and language: slower (0.8 = a fifth slower, pitch kept), the same loudness
+# and the same sample rate, so Vietnamese, English and Chinese pieces sound like one speaker's pace.
+# JAVIS_VOICE_SPEED changes the pace (1.0 = as the engine speaks, 0.7 = slower still).
+try:
+    SPEED = min(1.0, max(0.5, float(os.getenv("JAVIS_VOICE_SPEED", "0.8"))))
+except ValueError:
+    SPEED = 0.8
+_POST = f"atempo={SPEED},loudnorm=I=-16:TP=-1.5:LRA=11,aresample=24000"
+
+
+def home() -> Path:
+    try:
+        import config as cfg
+        return Path(cfg.STATE_DIR) / "tts"
+    except Exception:       # noqa: BLE001
+        return Path(os.getenv("JAVIS_STATE_DIR", ".")) / "tts"
+
+
+def language(text: str, voice: str = "") -> str:
+    """vi, en or zh: Chinese characters win, then Vietnamese letters, then the language of the named voice."""
+    t = str(text or "")
+    if _CJK.search(t):
+        return "zh"
+    if _VI.search(t):
+        return "vi"
+    v = str(voice or "").lower()
+    return "zh" if v.startswith("zh") else "vi" if v.startswith("vi") else "en"
+
+
+def available(lang: str) -> bool:
+    h = home()
+    return (h / "lib" / "piper").is_dir() and (h / "voices" / f"{VOICES[lang]}.onnx").is_file()
+
+
+def _load(lang: str):
+    if lang not in _LOADED:
+        lib = str(home() / "lib")
+        if lib not in sys.path:
+            sys.path.append(lib)
+        from piper import PiperVoice
+        _LOADED[lang] = PiperVoice.load(str(home() / "voices" / f"{VOICES[lang]}.onnx"))
+    return _LOADED[lang]
+
+
+def _speak_sync(text: str, lang: str) -> bytes:
+    buf = io.BytesIO()
+    w = wave.open(buf, "wb")
+    _load(lang).synthesize_wav(text, w)
+    w.close()
+    r = subprocess.run(["ffmpeg", "-loglevel", "error", "-f", "wav", "-i", "pipe:0", "-filter:a", _POST, "-codec:a", "libmp3lame",
+                        "-q:a", "4", "-f", "mp3", "pipe:1"], input=buf.getvalue(), capture_output=True, timeout=60)
+    return r.stdout if r.returncode == 0 else b""
+
+
+VIENEU_VOICE = "Trúc Ly"      # female, northern, natural (preset of VieNeu-TTS v3 Turbo, Apache-2.0)
+# argv: text, preset voice, out.wav, reference wav ("" = no clone). With a reference recording the model clones that
+# voice (the owner's "Giọng sách"): no AI tokens, a few seconds per sentence on the VPS. `pronounce.json` in the tts
+# folder (optional) rewrites words before they are read, like the daily-video skill does.
+_VIENEU_SCRIPT = ("import sys\nfrom vieneu import Vieneu\n"
+                  "text, voice, out, ref = sys.argv[1:5]\n"
+                  "if ref:\n"
+                  "    v = Vieneu(mode='v3turbo')\n"
+                  "    v.save(v.infer(text, ref_audio=ref), out)\n"
+                  "else:\n"
+                  "    v = Vieneu(precision='int8')\n"
+                  "    v.save(v.infer(text, voice=voice), out)\n")
+# How the company name is said (owner, 2026-11-18): the letters CREWVN read as one word come out wrong.
+_SAY = ((re.compile(r"\bcrewvn\b", re.I), "cờ riu vi en"),)
+
+
+def clone_ref() -> Optional[Path]:
+    """The recording of the voice to clone, or None (then the preset voice speaks). `JAVIS_VOICE_CLONE_REF` names it;
+    otherwise `<state>/tts/ref_giong.wav`. Put the owner's reference file there with
+    `python server/voice_offline.py clone <file.wav>`."""
+    for c in (os.getenv("JAVIS_VOICE_CLONE_REF", "").strip(), str(home() / "ref_giong.wav")):
+        if c and Path(c).is_file() and Path(c).stat().st_size > 2000:
+            return Path(c)
+    return None
+
+
+def _hf_dir() -> Path:
+    """Weights folder: `hf-w` (the clone model, v3 turbo) when it exists, else `hf`."""
+    h = home()
+    return h / "hf-w" if (h / "hf-w").is_dir() else h / "hf"
+
+
+def vieneu_available() -> bool:
+    h = home()
+    return (h / "vieneu-lib" / "vieneu").is_dir() and _hf_dir().is_dir()
+
+
+def say_words(text: str) -> str:
+    """The text as it must be pronounced: the company name spelled out, plus the optional `pronounce.json` dictionary
+    (`{"từ": "cách đọc"}`) in the tts folder."""
+    t = str(text or "")
+    for rx, rep in _SAY:
+        t = rx.sub(rep, t)
+    try:
+        import json
+        d = json.loads((home() / "pronounce.json").read_text(encoding="utf-8"))
+        for k, v in sorted(d.items(), key=lambda kv: -len(kv[0])):
+            if k:
+                t = re.sub(re.escape(str(k)), str(v), t, flags=re.I)
+    except (OSError, ValueError, AttributeError):
+        pass
+    return t
+
+
+# ---- Warm VieNeu: the model is loaded ONCE and kept in a worker process ---------------------------------------------
+# Starting VieNeu for every sentence spent most of the time loading the model (about 33 s for one short sentence on the
+# VPS). The worker loads it once and then reads one request per line: {"text", "voice", "out"} -> {"ok"} | {"error"}.
+# Protocol lines carry `_MARK` on a private copy of stdout; everything the library prints goes to stderr (a log file),
+# so a progress bar can never break the protocol. Pure code: no AI tokens are spent on speech.
+_MARK = "@@JAVIS_TTS@@"
+_WORKER_SCRIPT = (
+    "import os, sys, json\n"
+    "proto = os.fdopen(os.dup(1), 'w', encoding='utf-8')\n"
+    "os.dup2(2, 1)\n"
+    "ref = sys.argv[1]\n"
+    "from vieneu import Vieneu\n"
+    "v = Vieneu(mode='v3turbo') if ref else Vieneu(precision='int8')\n"
+    "try:\n"        # the FIRST sentence is slow (measured 22 s against 4-5 s for the next ones): pay it here, not in chat
+    "    v.infer('Xin chào.', ref_audio=ref) if ref else v.infer('Xin chào.', voice=sys.argv[2])\n"
+    "except Exception:\n"
+    "    pass\n"
+    "def say(d):\n"
+    f"    proto.write({_MARK!r} + json.dumps(d) + '\\n'); proto.flush()\n"
+    "say({'ready': True})\n"
+    "for line in sys.stdin:\n"
+    "    try:\n"
+    "        r = json.loads(line)\n"
+    "        a = v.infer(r['text'], ref_audio=ref) if ref else v.infer(r['text'], voice=r.get('voice'))\n"
+    "        v.save(a, r['out'])\n"
+    "        say({'ok': True})\n"
+    "    except Exception as e:\n"
+    "        say({'ok': False, 'error': type(e).__name__ + ': ' + str(e)[:200]})\n")
+WORKER_START_S = 240        # loading the model (first start on a 2-CPU VPS)
+WORKER_REQUEST_S = 150      # one sentence
+_W: Dict[str, object] = {"proc": None, "ref": None, "lock": None, "log": None}
+
+
+async def _worker_read(proc, timeout: float) -> dict:
+    import json
+    deadline = asyncio.get_running_loop().time() + timeout
+    while True:
+        left = deadline - asyncio.get_running_loop().time()
+        if left <= 0:
+            raise TimeoutError("VieNeu worker did not answer in time")
+        line = await asyncio.wait_for(proc.stdout.readline(), left)
+        if not line:
+            raise RuntimeError("VieNeu worker exited")
+        s = line.decode("utf-8", "replace").strip()
+        if s.startswith(_MARK):
+            return json.loads(s[len(_MARK):])
+
+
+def _worker_stop() -> None:
+    p = _W.get("proc")
+    _W["proc"] = None
+    if p is not None and p.returncode is None:
+        try:
+            p.kill()
+        except ProcessLookupError:
+            pass
+
+
+async def _worker() -> Optional[object]:
+    """The running worker for the current reference voice, started (and the model loaded) if needed. None on failure."""
+    ref = clone_ref()
+    key = str(ref) if ref else ""
+    p = _W.get("proc")
+    if p is not None and p.returncode is None and _W.get("ref") == key:
+        return p
+    _worker_stop()
+    h = home()
+    env = dict(os.environ, PYTHONPATH=str(h / "vieneu-lib"), HF_HOME=str(_hf_dir()), HF_HUB_OFFLINE="1",
+               PYTHONUNBUFFERED="1")
+    log = None
+    try:
+        log = open(h / "worker.log", "ab")
+    except OSError:
+        pass
+    t0 = asyncio.get_running_loop().time()
+    try:
+        p = await asyncio.create_subprocess_exec(sys.executable, "-c", _WORKER_SCRIPT, key, VIENEU_VOICE, env=env,
+                                                 stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
+                                                 stderr=log or asyncio.subprocess.DEVNULL)
+        _W.update(proc=p, ref=key)
+        first = await _worker_read(p, WORKER_START_S)
+        if not first.get("ready"):
+            raise RuntimeError(f"unexpected first line {first}")
+    except Exception as e:      # noqa: BLE001
+        print(f"[voice offline] VieNeu worker did not start: {type(e).__name__}: {e}", file=sys.stderr, flush=True)
+        _worker_stop()
+        return None
+    finally:
+        if log is not None:
+            log.close()         # the child keeps its own copy of the file
+    print(f"[voice offline] VieNeu worker ready in {asyncio.get_running_loop().time() - t0:.1f}s "
+          f"({'cloned voice' if key else 'preset voice'})", file=sys.stderr, flush=True)
+    return p
+
+
+async def _speak_warm(text: str) -> bytes:
+    """One sentence through the warm worker: mp3 bytes, or b"" (the worker is then restarted on the next call)."""
+    import json
+    import tempfile
+    if _W.get("lock") is None:
+        _W["lock"] = asyncio.Lock()
+    async with _W["lock"]:      # one sentence at a time: the model is not shared between requests
+        p = await _worker()
+        if p is None:
+            return b""
+        out = tempfile.NamedTemporaryFile(suffix=".wav", delete=False)
+        out.close()
+        try:
+            p.stdin.write((json.dumps({"text": say_words(text), "voice": VIENEU_VOICE, "out": out.name},
+                                      ensure_ascii=False) + "\n").encode("utf-8"))
+            await p.stdin.drain()
+            r = await _worker_read(p, WORKER_REQUEST_S)
+            if not r.get("ok"):
+                print(f"[voice offline] VieNeu worker: {r.get('error')}", file=sys.stderr, flush=True)
+                return b""
+            wav = Path(out.name).read_bytes()
+            return await asyncio.to_thread(_to_mp3, wav) if wav else b""
+        except Exception as e:      # noqa: BLE001 - a stuck or dead worker is replaced on the next sentence
+            print(f"[voice offline] VieNeu worker failed: {type(e).__name__}: {e}", file=sys.stderr, flush=True)
+            _worker_stop()
+            return b""
+        finally:
+            try:
+                os.unlink(out.name)
+            except OSError:
+                pass
+
+
+def warm_soon() -> None:
+    """Start the worker in the background (model loaded before the first voice message arrives). Never raises; does
+    nothing when VieNeu is not installed or `JAVIS_VIENEU_WARM=0`."""
+    if os.getenv("JAVIS_VIENEU_WARM", "1") == "0" or not vieneu_available():
+        return
+    try:
+        loop = asyncio.get_running_loop()
+    except RuntimeError:
+        return
+
+    async def go():
+        if _W.get("lock") is None:
+            _W["lock"] = asyncio.Lock()
+        async with _W["lock"]:
+            await _worker()
+    loop.create_task(go())
+
+
+async def speak_vi_clone(text: str) -> bytes:
+    """Vietnamese read by VieNeu (the cloned voice when a reference recording is set up). mp3 bytes, or b"" when VieNeu
+    is not installed or fails; never raises and never falls back to another engine, so the caller picks the fallback.
+    The warm worker answers first; a one-shot process (slow: loads the model) is the backup when the worker is off."""
+    if not vieneu_available() or not str(text or "").strip():
+        return b""
+    if os.getenv("JAVIS_VIENEU_WARM", "1") != "0":
+        b = await _speak_warm(text)
+        if b:
+            return b
+    try:
+        return await asyncio.to_thread(_vieneu_sync, text)
+    except Exception as e:      # noqa: BLE001
+        print(f"[voice offline] VieNeu failed: {type(e).__name__}: {e}", file=sys.stderr, flush=True)
+        return b""
+
+
+def _to_mp3(wav: bytes) -> bytes:
+    r = subprocess.run(["ffmpeg", "-loglevel", "error", "-f", "wav", "-i", "pipe:0", "-filter:a", _POST, "-codec:a", "libmp3lame",
+                        "-q:a", "4", "-f", "mp3", "pipe:1"], input=wav, capture_output=True, timeout=60)
+    return r.stdout if r.returncode == 0 else b""
+
+
+def _vieneu_sync(text: str) -> bytes:
+    """Vietnamese (and Vietnamese-English mixed) text read by VieNeu in its own process: its numpy and onnxruntime
+    stay in `<state>/tts/vieneu-lib` and never meet the server's. Weights are in `<state>/tts/hf`, read offline."""
+    import tempfile
+    h = home()
+    env = dict(os.environ, PYTHONPATH=str(h / "vieneu-lib"), HF_HOME=str(_hf_dir()), HF_HUB_OFFLINE="1")
+    out = tempfile.NamedTemporaryFile(suffix=".wav", delete=False)
+    out.close()
+    ref = clone_ref()
+    try:
+        r = subprocess.run([sys.executable, "-c", _VIENEU_SCRIPT, say_words(text), VIENEU_VOICE, out.name,
+                            str(ref) if ref else ""], env=env, capture_output=True, text=True, timeout=180)
+        wav = Path(out.name).read_bytes()
+        if r.returncode != 0 or not wav:
+            print(f"[voice offline] VieNeu gave no audio (exit {r.returncode}): {(r.stderr or '').strip()[-200:]}",
+                  file=sys.stderr, flush=True)
+            return b""
+        return _to_mp3(wav)
+    finally:
+        try:
+            os.unlink(out.name)
+        except OSError:
+            pass
+
+
+_RUN = re.compile(r"[㐀-鿿，、。！？；]+|[^㐀-鿿，、。！？；]+")
+_CLAUSE = re.compile(r"(?<=[.!?;\n])\s+")
+
+
+def segments(text: str, voice: str = "") -> list:
+    """[(lang, text)] in reading order: a sentence that mixes Vietnamese, English and Chinese is cut at sentence
+    ends and at every change between Chinese characters and other letters; neighbours in the same language are
+    joined, so each engine is started as few times as possible."""
+    out: list = []
+    for clause in _CLAUSE.split(str(text or "")):
+        for run in _RUN.findall(clause):
+            if not re.search(r"\w", run):
+                continue
+            lang = "zh" if _CJK.search(run) else "vi" if _VI.search(run) else ("vi" if str(voice).lower().startswith("vi") and not out else "en")
+            if out and out[-1][0] == lang:
+                out[-1] = (lang, out[-1][1] + " " + run.strip())
+            else:
+                out.append((lang, run.strip()))
+    return out
+
+
+def _concat(parts: list) -> bytes:
+    """One mp3 from several (the engines run at different sample rates, so they are decoded and joined)."""
+    import tempfile
+    tmp = tempfile.mkdtemp()
+    try:
+        cmd = ["ffmpeg", "-loglevel", "error", "-y"]
+        for i, b in enumerate(parts):
+            p = Path(tmp) / f"{i}.mp3"
+            p.write_bytes(b)
+            cmd += ["-i", str(p)]
+        cmd += ["-filter_complex", "".join(f"[{i}:a]aresample=24000[a{i}];" for i in range(len(parts)))
+                + "".join(f"[a{i}]" for i in range(len(parts))) + f"concat=n={len(parts)}:v=0:a=1[o]",
+                "-map", "[o]", "-codec:a", "libmp3lame", "-q:a", "4", "-f", "mp3", "pipe:1"]
+        r = subprocess.run(cmd, capture_output=True, timeout=90)
+        return r.stdout if r.returncode == 0 else b""
+    finally:
+        import shutil
+        shutil.rmtree(tmp, ignore_errors=True)
+
+
+async def speak(text: str, voice: str = "") -> bytes:
+    """mp3 bytes, or b"" when an offline voice is missing or fails (never raises). Mixed-language text is read
+    piece by piece, each in its own language."""
+    segs = segments(text, voice)
+    if len(segs) <= 1:
+        return await _speak_one(text, language(text, voice))
+    parts = []
+    for lang, seg in segs:
+        b = await _speak_one(seg, lang)
+        if not b:
+            return b""
+        parts.append(b)
+    try:
+        return await asyncio.to_thread(_concat, parts)
+    except Exception as e:      # noqa: BLE001
+        print(f"[voice offline] joining failed: {type(e).__name__}: {e}", file=sys.stderr, flush=True)
+        return b""
+
+
+async def _speak_one(text: str, lang: str) -> bytes:
+    if lang == "vi" and vieneu_available():
+        try:
+            mp3 = await asyncio.to_thread(_vieneu_sync, text)
+            if mp3:
+                return mp3
+        except Exception as e:      # noqa: BLE001
+            print(f"[voice offline] VieNeu failed: {type(e).__name__}: {e}", file=sys.stderr, flush=True)
+    if not available(lang):
+        return b""
+    try:
+        return await asyncio.to_thread(_speak_sync, text, lang)
+    except Exception as e:      # noqa: BLE001
+        print(f"[voice offline] {lang} failed: {type(e).__name__}: {e}", file=sys.stderr, flush=True)
+        return b""
+
+
+def offline_first(online):
+    """A `synth(text, voice)` for voice_note.make: offline voice first, the given online one when it gives nothing."""
+    async def synth(text: str, voice: str) -> bytes:
+        return await speak(text, voice) or await online(text, voice)
+    return synth
+
+
+def install(target: Optional[Path] = None) -> None:
+    """Download the engine and the three voices into `<state>/tts` (needs internet once)."""
+    import urllib.request
+    h = Path(target) if target else home()
+    (h / "voices").mkdir(parents=True, exist_ok=True)
+    subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", "--target", str(h / "lib"), "piper-tts"], check=True)
+    for lang, name in VOICES.items():
+        for ext in (".onnx", ".onnx.json"):
+            dst = h / "voices" / (name + ext)
+            if not dst.exists():
+                urllib.request.urlretrieve(_BASE + _PATHS[lang] + name + ext, dst)
+            print(dst, dst.stat().st_size)
+
+
+def set_clone_ref(src: str) -> Path:
+    """Copy the reference recording of the voice to clone into `<state>/tts/ref_giong.wav`."""
+    import shutil
+    s = Path(src)
+    if not s.is_file() or s.stat().st_size <= 2000:
+        raise FileNotFoundError(f"reference recording not found or empty: {src}")
+    dst = home() / "ref_giong.wav"
+    dst.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(s, dst)
+    return dst
+
+
+if __name__ == "__main__" and len(sys.argv) > 1 and sys.argv[1] == "install":
+    install()
+elif __name__ == "__main__" and len(sys.argv) > 2 and sys.argv[1] == "clone":
+    print(set_clone_ref(sys.argv[2]))
