+            else "ERROR: could not learn that pair (empty, identical, or the lexicon is full)."
+    rows = zvr.load(vault_root)
+    return "\n".join(f"{k} -> {v['right']}" for k, v in sorted(rows.items())) or "The lexicon has no learned words yet."
 
 
