+def remember(url: str, text: str) -> None:
+    """Keep a transcript for a link so the next turn does not hear the same voice message again."""
+    if not url or not text:
+        return
+    with _lock:
+        d = _load()
+        d[url] = {"text": text, "ts": time.time()}
+        _save(d)
